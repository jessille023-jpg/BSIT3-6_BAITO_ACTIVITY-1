<!DOCTYPE html>
<html>
<head>
    <title>Biodata - BSIT</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f0f2f5;
        }

        .container {
            width: 90%;
            max-width: 800px;
            margin: 40px auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
        }

        .header h1 {
            margin-bottom: 5px;
        }

        .header p {
            margin-top: 0;
            color: #666;
        }

        .section-title {
            margin-top: 25px;
            padding: 10px;
            background: #333;
            color: white;
            border-radius: 6px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 11px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
        }

        .row {
            display: flex;
            gap: 15px;
        }

        .row .form-group {
            flex: 1;
        }

        button {
            width: 100%;
            padding: 13px;
            margin-top: 15px;
            border: none;
            border-radius: 6px;
            background: #333;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #555;
        }

        .details-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            text-decoration: none;
            color: #333;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>BIODATA</h1>
        <p>BSIT Student Information</p>
    </div>

    <form action="/insert" method="POST">

        <h3 class="section-title">Personal Information</h3>

        <div class="row">
            <div class="form-group">
                <label>First Name</label>
                <input type="text" name="firstname" required>
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input type="text" name="lastname" required>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <label>Age</label>
                <input type="number" name="age" required>
            </div>

            <div class="form-group">
                <label>Gender</label>
                <select name="gender" required>
                    <option value="">Select Gender</option>
                    <option>Male</option>
                    <option>Female</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Birthday</label>
            <input type="date" name="birthday" required>
        </div>

        <div class="form-group">
            <label>Address</label>
            <input type="text" name="address" required>
        </div>

        <h3 class="section-title">Contact Information</h3>

        <div class="form-group">
            <label>Contact Number</label>
            <input type="text" name="contact" required>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" required>
        </div>

        <h3 class="section-title">Education</h3>

        <div class="form-group">
            <label>Course</label>
            <input type="text" name="course"
                   value="Bachelor of Science in Information Technology"
                   required>
        </div>

        <div class="row">
            <div class="form-group">
                <label>Year Level</label>
                <select id="yearlevel" name="yearlevel" required>
                    <option value="">Select Year Level</option>
                    <option value="1st Year">1st Year</option>
                    <option value="2nd Year">2nd Year</option>
                    <option value="3rd Year">3rd Year</option>
                    <option value="4th Year">4th Year</option>
                </select>
            </div>

            <div class="form-group">
                <label>Section</label>
                <select id="section" name="section" required>
                    <option value="">Select Section</option>
                </select>
            </div>
        </div>

        <h3 class="section-title">About Me</h3>

        <div class="form-group">
            <label>Hobbies</label>
            <textarea name="hobbies" rows="3"
                      placeholder="Enter your hobbies"></textarea>
        </div>

        <div class="form-group">
            <label>Skills</label>
            <textarea name="skills" rows="3"
                      placeholder="Enter your skills"></textarea>
        </div>

        <div class="form-group">
            <label>Life Motto</label>
            <textarea name="motto" rows="3"
                      placeholder="Enter your motto"></textarea>
        </div>

        <button type="submit">SUBMIT BIODATA</button>

    </form>
    <script>
    const yearLevel = document.getElementById("yearlevel");
    const section = document.getElementById("section");

    const sections = {
        "1st Year": [
            "BSIT 1-1",
            "BSIT 1-2",
            "BSIT 1-3",
            "BSIT 1-4"
        ],

        "2nd Year": [
            "BSIT 2-1",
            "BSIT 2-2",
            "BSIT 2-3",
            "BSIT 2-4"
        ],

        "3rd Year": [
            "BSIT 3-1",
            "BSIT 3-2",
            "BSIT 3-3",
            "BSIT 3-4",
            "BSIT 3-5",
            "BSIT 3-6"
        ],

        "4th Year": [
            "BSIT 4-1",
            "BSIT 4-2",
            "BSIT 4-3",
            "BSIT 4-4"
        ]
    };

    yearLevel.addEventListener("change", function() {

        section.innerHTML = '<option value="">Select Section</option>';

        const selectedYear = this.value;

        if (sections[selectedYear]) {

            sections[selectedYear].forEach(function(sec) {

                const option = document.createElement("option");

                option.value = sec;
                option.textContent = sec;

                section.appendChild(option);
            });
        }
    });
</script>

    <a class="details-link" href="/details">
        View Registered Details
    </a>

</div>

</body>
</html>